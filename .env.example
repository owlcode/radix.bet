# Copy to .env. These defaults match docker-compose.yml, so the playground
# works with no edits.

# --- Local services (docker compose up -d) ---------------------------------
RADIXBET_DATABASE_URL=postgresql://radixbet:radixbet@localhost:5433/radixbet
RADIXBET_VALKEY_URL=redis://localhost:6380

# --- Radix network ---------------------------------------------------------
# Stokenet is Radix's public testnet. XRD there is free from the faucet and
# worth nothing, which is the whole point of a playground.
RADIX_NETWORK=stokenet
RADIX_GATEWAY_URL=https://stokenet.radixdlt.com

# Address of YOUR deployed `owl-bets` package. Empty until you publish the
# blueprint yourself — see "Deploying the blueprint" in the README. The web UI
# reads seeded markets without it; creating a new market needs it.
RADIX_PACKAGE_ADDRESS=

# Signs the session cookie issued after a ROLA wallet login. Any random string
# works locally.
JWT_SECRET=local-playground-secret-change-me

# Public origin the web app builds absolute links against.
PUBLIC_URL=http://localhost:5173

LOG_LEVEL=info
