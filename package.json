{
  "name": "radix.bet",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "dotenv -- turbo run dev",
    "dev:web": "dotenv -- turbo run dev --filter @radix-bet/web",
    "build": "dotenv -- turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "turbo run db:generate",
    "db:push": "pnpm --filter @radix-bet/database db:push",
    "db:seed": "pnpm --filter @radix-bet/database db:seed",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "setup": "cp -n .env.example .env 2>/dev/null || true; pnpm install && pnpm services:up && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "scrypto:build": "cd scrypto && scrypto build",
    "scrypto:test": "cd scrypto && cargo test",
    "scrypto:publish": "dotenv -- tsx scripts/deploy-scrypto.ts",
    "faucet": "dotenv -- tsx scripts/claim-faucet.ts",
    "accounts:generate": "dotenv -- tsx scripts/generate-test-accounts.ts",
    "oracle:games": "dotenv -- tsx scripts/check-oracle-games.ts",
    "oracle:backfill": "dotenv -- tsx scripts/backfill-bets-from-oracle.ts"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "@sveltejs/kit",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "secp256k1"
    ]
  },
  "dependencies": {
    "@radix-bet/radix": "workspace:*"
  }
}
