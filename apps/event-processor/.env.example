NODE_ENV=development
PORT=3001

# Database
RADIXBET_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/radixbet

# Redis
RADIXBET_VALKEY_URL=redis://localhost:6380

# Radix Network
RADIX_NETWORK=stokenet
RADIX_GATEWAY_URL=https://stokenet.radixdlt.com
RADIX_PACKAGE_ADDRESS=

# Webhook Security

HOOKAH_BASE_URL=https://app.hookah.ing
HOOKAH_PUBLIC_KEY=
HOOKAH_PRIVATE_KEY=
HOOKAH_WEBHOOK_URL=
HOOKAH_WEBHOOK_SECRET=your-secret-key-here

# Feature Flags
LOG_LEVEL=info
